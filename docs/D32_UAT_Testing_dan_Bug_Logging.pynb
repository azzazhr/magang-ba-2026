{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"10j8dLQxH-40IIF6srdZ1gUikyr3HlTAi","timestamp":1794971763769},{"file_id":"1YlKz_bnnHiGaK5bPjLKtkeJ-OtHrpec4","timestamp":1794970489901},{"file_id":"1ivL-W7f22qCyyQl8WAQjNgWunfwiucPr","timestamp":1794884642962},{"file_id":"1Y8qyNxvFwyBOcnHsXJvDzqwsC1Y3fppU","timestamp":1794454671986},{"file_id":"1hgmPuK_n5U88nSFQMZEBPb8D9kjdODWH","timestamp":1794451655837},{"file_id":"1HrV3IJmW8w3phizz13vcyuOR7KDJg70h","timestamp":1794318363544},{"file_id":"1tmoA0U38frg6zJ_yirHb3s_KRJu5QAhj","timestamp":1794199316222},{"file_id":"1x9fwVn826E8MXjQL3THtqUvkSRW5krlN","timestamp":1794193271613},{"file_id":"1QJzA2EilN-v_hstwMWfvmU5fRwnKnWN7","timestamp":1793856951693},{"file_id":"1imEO7NJ4Usw-tme1v7ojrtw7z0x8x2s4","timestamp":1793846131273},{"file_id":"1_HyQNYg8fUos_Cshd0G-n5TxqwwoycAe","timestamp":1793760463876},{"file_id":"1sE6QioyerUx4zs0o8k8rx6hlUn-ZTsds","timestamp":1793673740199},{"file_id":"1d3aczKzscAxf4Isp_QDPDIZ3YVCBEbcg","timestamp":1793447032165},{"file_id":"1Cuy9lYnlIXUpw-2Rs8AxwgrpSaVO7puT","timestamp":1793247802453},{"file_id":"1qqURwWLXpqdhL4Y2bezvI3IpYgMwF9m4","timestamp":1793242373771}],"authorship_tag":"ABX9TyOaOL5XSzB/5Kr2ddDmW+/D"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":2,"metadata":{"id":"C6amgp1flBQo","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1795008423194,"user_tz":-420,"elapsed":1420,"user":{"displayName":"Azzahra Attaqina","userId":"02773810987872161099"}},"outputId":"42ea39ad-2146-4a08-d13b-55f90199b1a6"},"outputs":[{"output_type":"stream","name":"stdout","text":["Drive already mounted at /content/drive; to attempt to forcibly remount, call drive.mount(\"/content/drive\", force_remount=True).\n"]}],"source":["from google.colab import drive\n","drive.mount('/content/drive')"]},{"cell_type":"code","source":["import os\n","\n","os.chdir('/content/drive/MyDrive/magang-ba-2026')\n","print(\"Direktori aktif sekarang berada di:\", os.getcwd())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Sr_j9_OzlDE9","executionInfo":{"status":"ok","timestamp":1795008426649,"user_tz":-420,"elapsed":18,"user":{"displayName":"Azzahra Attaqina","userId":"02773810987872161099"}},"outputId":"2f43717c-a3a3-4f71-e1f5-ae8d7122cc28"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["Direktori aktif sekarang berada di: /content/drive/MyDrive/magang-ba-2026\n"]}]},{"cell_type":"markdown","source":["**Menyiapkan Basis Data Uji Baru**"],"metadata":{"id":"RqlQwXCx2xLn"}},{"cell_type":"code","source":["import os\n","import glob\n","import shutil\n","import sqlite3\n","\n","# 1. Pastikan folder bukti tersedia\n","os.makedirs('reports/evidence', exist_ok=True)\n","os.makedirs('data/backup', exist_ok=True)\n","\n","# 2. Cari file database utama di proyek\n","db_files = [f for f in (glob.glob('**/*.db', recursive=True) + glob.glob('**/*.sqlite*', recursive=True)) if 'backup' not in f]\n","print(\"File database ditemukan:\", db_files)\n","\n","# 3. Backup otomatis database utama (jika ada) sebelum membuat DB uji baru\n","for db_path in db_files:\n","    backup_path = os.path.join('data/backup', f\"backup_sebelum_D32_{os.path.basename(db_path)}\")\n","    shutil.copy2(db_path, backup_path)\n","    print(f\"Backup aman dibuat di: {backup_path}\")\n","\n","# 4. Cek struktur docs/bug_list.csv yang sudah ada\n","if os.path.exists('docs/bug_list.csv'):\n","    with open('docs/bug_list.csv', 'r', encoding='utf-8') as f:\n","        print(\"\\nHeader docs/bug_list.csv saat ini:\", f.readline().strip())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"hn4C3OS1r4OE","executionInfo":{"status":"ok","timestamp":1794987147408,"user_tz":-420,"elapsed":808,"user":{"displayName":"Azzahra Attaqina","userId":"02773810987872161099"}},"outputId":"8ada8181-7cfd-4d72-d565-481abaefc061"},"execution_count":32,"outputs":[{"output_type":"stream","name":"stdout","text":["File database ditemukan: ['data/app.db', 'data/app_test.db', 'data/sentiment_d28.db', 'data/sentiment.db']\n","Backup aman dibuat di: data/backup/backup_sebelum_D32_app.db\n","Backup aman dibuat di: data/backup/backup_sebelum_D32_app_test.db\n","Backup aman dibuat di: data/backup/backup_sebelum_D32_sentiment_d28.db\n","Backup aman dibuat di: data/backup/backup_sebelum_D32_sentiment.db\n","\n","Header docs/bug_list.csv saat ini: bug_id,tc_id,modul,tingkat_keparahan,deskripsi_masalah,langkah_reproduksi,status_perbaikan,bukti\n"]}]},{"cell_type":"markdown","source":["**Mengosongkan Database Uji Aktif**"],"metadata":{"id":"0x1ka0L-sHk7"}},{"cell_type":"code","source":["import sqlite3\n","import os\n","\n","# Cek isi tabel pada masing-masing database untuk mengetahui mana yang dipakai aplikasi\n","for db_path in ['data/app.db', 'data/sentiment.db']:\n","    if os.path.exists(db_path):\n","        conn = sqlite3.connect(db_path)\n","        cursor = conn.cursor()\n","        tables = cursor.execute(\"SELECT name FROM sqlite_master WHERE type='table';\").fetchall()\n","        print(f\"Database {db_path} memiliki tabel:\", [t[0] for t in tables])\n","        for t in tables:\n","            count = cursor.execute(f\"SELECT COUNT(*) FROM {t[0]}\").fetchone()[0]\n","            print(f\"   - {t[0]}: {count} baris\")\n","        conn.close()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"oXECezB2sJM5","executionInfo":{"status":"ok","timestamp":1794987149522,"user_tz":-420,"elapsed":130,"user":{"displayName":"Azzahra Attaqina","userId":"02773810987872161099"}},"outputId":"659b3173-421c-4827-bd10-5bf5a17f8446"},"execution_count":33,"outputs":[{"output_type":"stream","name":"stdout","text":["Database data/app.db memiliki tabel: ['posts', 'comments', 'annotators', 'sqlite_sequence', 'annotations']\n","   - posts: 120 baris\n","   - comments: 915 baris\n","   - annotators: 0 baris\n","   - sqlite_sequence: 0 baris\n","   - annotations: 0 baris\n","Database data/sentiment.db memiliki tabel: ['predictions', 'sqlite_sequence', 'comments', 'verification_history']\n","   - predictions: 0 baris\n","   - sqlite_sequence: 0 baris\n","   - comments: 0 baris\n","   - verification_history: 0 baris\n"]}]},{"cell_type":"markdown","source":["**Reset Database Uji Baru (Kosongkan Baris, Pertahankan Skema)**"],"metadata":{"id":"Jj559wpvsmKf"}},{"cell_type":"code","source":["import sqlite3\n","\n","def reset_db(db_path, tables):\n","    conn = sqlite3.connect(db_path)\n","    cursor = conn.cursor()\n","    # Matikan pengecekan foreign key sementara agar urutan penghapusan aman\n","    cursor.execute(\"PRAGMA foreign_keys = OFF;\")\n","    for table in tables:\n","        cursor.execute(f\"DELETE FROM {table};\")\n","        # Reset auto-increment jika tabel ada di sqlite_sequence\n","        cursor.execute(\"DELETE FROM sqlite_sequence WHERE name = ?;\", (table,))\n","    cursor.execute(\"PRAGMA foreign_keys = ON;\")\n","    conn.commit()\n","\n","    print(f\"{db_path} berhasil direset (0 baris):\")\n","    for table in tables:\n","        cnt = cursor.execute(f\"SELECT COUNT(*) FROM {table};\").fetchone()[0]\n","        print(f\"   - {table}: {cnt} baris\")\n","    conn.close()\n","\n","# Reset kedua database aktif\n","reset_db('data/app.db', ['annotations', 'annotators', 'comments', 'posts'])\n","reset_db('data/sentiment.db', ['verification_history', 'predictions', 'comments'])"],"metadata":{"id":"EKfDBlkNsoUX","executionInfo":{"status":"ok","timestamp":1794987152458,"user_tz":-420,"elapsed":77,"user":{"displayName":"Azzahra Attaqina","userId":"02773810987872161099"}},"outputId":"2dcb5863-3e1e-4e7e-eee4-eac859b6e456","colab":{"base_uri":"https://localhost:8080/"}},"execution_count":34,"outputs":[{"output_type":"stream","name":"stdout","text":["data/app.db berhasil direset (0 baris):\n","   - annotations: 0 baris\n","   - annotators: 0 baris\n","   - comments: 0 baris\n","   - posts: 0 baris\n","data/sentiment.db berhasil direset (0 baris):\n","   - verification_history: 0 baris\n","   - predictions: 0 baris\n","   - comments: 0 baris\n"]}]},{"cell_type":"markdown","source":["**Mencatat bug_list**"],"metadata":{"id":"eVs0Kb15BMwM"}},{"cell_type":"code","source":["import os\n","import pandas as pd\n","from openpyxl import load_workbook\n","\n","# 1. Buat docs/bug_list.csv\n","os.makedirs(\"docs\", exist_ok=True)\n","bugs = [\n","    {\n","        \"bug_id\": \"BUG-01\",\n","        \"tc_id\": \"TC-05\",\n","        \"modul\": \"Impor Data (src/importer.py)\",\n","        \"tingkat_keparahan\": \"Tinggi\",\n","        \"deskripsi_masalah\": \"Baris komentar dengan tanggal tidak valid (2026-99-99 25:61:00) dan di luar rentang (1998-05-12 08:00:00) lolos diimpor (Diterima: 2) tanpa penolakan aturan validasi tanggal Q05/Q06.\",\n","        \"langkah_reproduksi\": \"1. Buka menu Impor -> Comments. 2. Unggah tc05_tanggal_invalid.csv. 3. Klik Mulai Impor Comments.\",\n","        \"status_perbaikan\": \"Terbuka\",\n","        \"bukti\": \"reports/evidence/T05.png\"\n","    },\n","    {\n","        \"bug_id\": \"BUG-02\",\n","        \"tc_id\": \"TC-07\",\n","        \"modul\": \"Eksplorasi Data (src/queries.py)\",\n","        \"tingkat_keparahan\": \"Tinggi\",\n","        \"deskripsi_masalah\": \"Kombinasi filter rentang tanggal bersama platform Instagram memicu TypeError: Invalid comparison between dtype=datetime64[s] and date pada src/queries.py baris 158 saat kolom commented_at kosong/NaT.\",\n","        \"langkah_reproduksi\": \"1. Buka menu Data. 2. Pilih Platform Instagram dan isi Dari Tanggal (2026/09/01) serta Sampai Tanggal (2026/09/30).\",\n","        \"status_perbaikan\": \"Terbuka\",\n","        \"bukti\": \"reports/evidence/TC07.png\"\n","    },\n","    {\n","        \"bug_id\": \"BUG-03\",\n","        \"tc_id\": \"TC-15\",\n","        \"modul\": \"Ekspor Data (app/pages/6_Ekspor.py)\",\n","        \"tingkat_keparahan\": \"Sedang\",\n","        \"deskripsi_masalah\": \"Halaman Ekspor hanya mengunduh berkas CSV tunggal tanpa menyertakan file manifest/metadata ekspor (versi data, versi model, parameter filter, dan jumlah baris).\",\n","        \"langkah_reproduksi\": \"1. Buka menu Ekspor. 2. Klik Unduh Berkas CSV (Filtered Export). 3. Periksa berkas terunduh dan direktori proyek.\",\n","        \"status_perbaikan\": \"Terbuka\",\n","        \"bukti\": \"reports/evidence/T15.png\"\n","    }\n","]\n","\n","df_bugs = pd.DataFrame(bugs)\n","df_bugs.to_csv(\"docs/bug_list.csv\", index=False, encoding=\"utf-8\")\n","print(\"docs/bug_list.csv berhasil dibuat:\")\n","print(df_bugs[[\"bug_id\", \"tc_id\", \"modul\", \"tingkat_keparahan\", \"status_perbaikan\"]])"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"V6gDOySWBSXr","executionInfo":{"status":"ok","timestamp":1794987154990,"user_tz":-420,"elapsed":47,"user":{"displayName":"Azzahra Attaqina","userId":"02773810987872161099"}},"outputId":"70cb7390-7378-477a-98e5-b4538f3365e1"},"execution_count":35,"outputs":[{"output_type":"stream","name":"stdout","text":["docs/bug_list.csv berhasil dibuat:\n","   bug_id  tc_id                                modul tingkat_keparahan  \\\n","0  BUG-01  TC-05         Impor Data (src/importer.py)            Tinggi   \n","1  BUG-02  TC-07     Eksplorasi Data (src/queries.py)            Tinggi   \n","2  BUG-03  TC-15  Ekspor Data (app/pages/6_Ekspor.py)            Sedang   \n","\n","  status_perbaikan  \n","0          Terbuka  \n","1          Terbuka  \n","2          Terbuka  \n"]}]},{"cell_type":"markdown","source":["Memperbarui test/test_case.xls"],"metadata":{"id":"M4Dx9zx7BVc2"}},{"cell_type":"code","source":["# 2. Perbarui tests/test_cases.xlsx\n","hasil_uat = {\n","    \"TC-01\": (\"2 baris posts dan 5 baris comments valid berhasil diimpor dan tampil lengkap di halaman Data (Ditemukan 5 Komentar).\", \"Lulus\", \"reports/evidence/TC01(4).png\"),\n","    \"TC-02\": (\"File tc02_kolom_hilang.csv ditolak dengan pesan eksplisit: 'File ditolak! Kolom wajib berikut hilang dari file: text_original'.\", \"Lulus\", \"reports/evidence/TC02.png\"),\n","    \"TC-03\": (\"File tc03_encoding_rusak.csv ditolak secara bersih dengan pesan: 'File ditolak! Encoding file tidak valid (bukan UTF-8)' tanpa crash.\", \"Lulus\", \"reports/evidence/TC03.png\"),\n","    \"TC-04\": (\"Kedua baris dengan post_id tidak terdaftar ditolak dengan alasan 'Q09: unggahan sumber tidak ditemukan' (Diterima: 0, Ditolak: 2).\", \"Lulus\", \"reports/evidence/T04(2).png\"),\n","    \"TC-05\": (\"Kedua baris dengan tanggal invalid (2026-99-99 & 1998-05-12) lolos masuk ke database (Diterima: 2, Ditolak: 0) tanpa penolakan Q05/Q06.\", \"Gagal\", \"reports/evidence/T05.png\"),\n","    \"TC-06\": (\"Impor ulang file tc01_comments_valid.csv tidak menambah baris duplikat di database (Diterima: 0, Dilewati: 5).\", \"Lulus\", \"reports/evidence/T06(2).png\"),\n","    \"TC-07\": (\"Filter rentang tanggal bersama platform Instagram memicu TypeError: Invalid comparison between dtype=datetime64[s] and date pada src/queries.py baris 158.\", \"Gagal\", \"reports/evidence/TC07.png\"),\n","    \"TC-08\": (\"Kata kunci 'daftar' menampilkan 2 komentar sesuai; kata kunci tidak ada ('abcd') menampilkan 'Ditemukan 0 Komentar' tanpa galat.\", \"Lulus\", \"reports/evidence/TC08(2).png\"),\n","    \"TC-09\": (\"Proses analisis sentimen berhasil memproses 5 komentar lengkap dengan predicted_label, score, predicted_at, dan model_version T3_indobert_len64.\", \"Lulus\", \"reports/evidence/T09(2).png\"),\n","    \"TC-10\": (\"Eksekusi ulang analisis pada komentar yang sama menambahkan 5 riwayat prediksi baru (2026-11-18T11:27:23) tanpa menimpa riwayat sebelumnya (11:26:21).\", \"Lulus\", \"reports/evidence/T10(2).png\"),\n","    \"TC-11\": (\"Koreksi label TEST_CMT_001 (positif -> netral) tersimpan lengkap beserta reviewer_azza, alasan, waktu, dan mempertahankan prediksi asli model.\", \"Lulus\", \"reports/evidence/T11(2).png\"),\n","    \"TC-12\": (\"Pengajuan koreksi dengan alasan kosong ditolak dengan pesan 'Validasi Gagal: Alasan minimal 5 karakter'.\", \"Lulus\", \"reports/evidence/T12.png\"),\n","    \"TC-13\": (\"Dashboard menampilkan metrik akurat (5 unggahan, 5 diprediksi, 2 terverifikasi / 40.0%) beserta pemilih sumber label dan catatan cakupan data.\", \"Lulus\", \"reports/evidence/T13(1).png\"),\n","    \"TC-14\": (\"Ekspor terfilter menghasilkan file CSV berisi 5 baris dan 21 kolom sesuai kontrak tanpa kolom identitas pribadi.\", \"Lulus\", \"reports/evidence/T14.png\"),\n","    \"TC-15\": (\"Halaman Ekspor hanya menyediakan unduhan berkas CSV tanpa menghasilkan file manifest/metadata ekspor (versi model, filter, versi data).\", \"Gagal\", \"reports/evidence/T15.png\"),\n","}\n","\n","wb = load_workbook(\"tests/test_cases.xlsx\")\n","ws = wb.active\n","headers = {str(cell.value).strip().lower(): idx + 1 for idx, cell in enumerate(ws[1]) if cell.value}\n","\n","for row_idx in range(2, ws.max_row + 1):\n","    tc_id = str(ws.cell(row=row_idx, column=headers.get(\"id\", 1)).value or \"\").strip()\n","    if tc_id in hasil_uat:\n","        aktual, status, bukti = hasil_uat[tc_id]\n","        for col_name, val in [\n","            (\"hasil aktual\", aktual),\n","            (\"status\", status),\n","            (\"tanggal uji\", \"2026-11-18\"),\n","            (\"penguji\", \"Azzahra Attaqina\"),\n","            (\"bukti\", bukti),\n","        ]:\n","            for h_key, col_idx in headers.items():\n","                if col_name in h_key:\n","                    ws.cell(row=row_idx, column=col_idx, value=val)\n","\n","wb.save(\"tests/test_cases.xlsx\")\n","print(\"tests/test_cases.xlsx berhasil diperbarui.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Lhf4pHaUBbKJ","executionInfo":{"status":"ok","timestamp":1794987157748,"user_tz":-420,"elapsed":58,"user":{"displayName":"Azzahra Attaqina","userId":"02773810987872161099"}},"outputId":"d4f0ed2b-3eb8-4b45-9bfa-9f6626dbfa68"},"execution_count":36,"outputs":[{"output_type":"stream","name":"stdout","text":["tests/test_cases.xlsx berhasil diperbarui.\n"]}]},{"cell_type":"markdown","source":["**Memulihkan database asli dari backup**"],"metadata":{"id":"GdqrWAOIBguE"}},{"cell_type":"code","source":["import os\n","import shutil\n","from google.colab import drive\n","\n","drive.mount('/content/drive')\n","\n","project_dir = '/content/drive/MyDrive/magang-ba-2026'\n","os.chdir(project_dir)\n","\n","backup_dir = \"data/backup\"\n","\n","for db_name in [\"app.db\", \"sentiment.db\"]:\n","    backup_src = os.path.join(\n","        backup_dir,\n","        f\"backup_sebelum_D32_{db_name}\"\n","    )\n","    target_dst = os.path.join(\"data\", db_name)\n","\n","    if os.path.isfile(backup_src):\n","        shutil.copy2(backup_src, target_dst)\n","        print(f\"Database lama dipulihkan ke: {target_dst}\")\n","    else:\n","        print(f\"Backup tidak ditemukan: {backup_src}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"u3lUwIb2Bi7a","executionInfo":{"status":"ok","timestamp":1795008439121,"user_tz":-420,"elapsed":1393,"user":{"displayName":"Azzahra Attaqina","userId":"02773810987872161099"}},"outputId":"25f034f0-8f15-4c52-f5b5-d0b46389498e"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["Drive already mounted at /content/drive; to attempt to forcibly remount, call drive.mount(\"/content/drive\", force_remount=True).\n","Database lama dipulihkan ke: data/app.db\n","Database lama dipulihkan ke: data/sentiment.db\n"]}]}]}